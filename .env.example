# Copy to renderer/.env and fill in. Everything is optional except resolution —
# widgets whose config is blank just render a placeholder. See CONFIGURATION.md.

# --- display ---------------------------------------------------------------
# Match your Kindle's screen (landscape: width >= height; the renderer rotates
# for the device). Paperwhite 2 = 1024x758; PW3+/Oasis = 1448x1072.
KINDLE_W=1024
KINDLE_H=758
TZ=America/Sao_Paulo

# Visual options — all server-side, so the device just opens a bare /dash.png.
DASH_ROTATE=0          # 0/90/180/270; 90 fills a portrait panel mounted sideways
DASH_DARK=0            # 1 = light-on-black (e-ink dark mode)
DASH_WIDGETS=clock,weather,forecast,agenda,sun,rain,usage,battery   # which panels, in order
# Usage providers (usage=Claude, codex, opencode, openrouter) share the bottom strip and
# split it into columns. Add them to DASH_WIDGETS to show them, e.g.:
#   DASH_WIDGETS=clock,weather,forecast,agenda,sun,rain,usage,codex,opencode,openrouter,battery
# battery = the Kindle's charge (top-right); dashboard.sh reports it on each fetch.

# Host port the renderer is published on (compose). The Kindle fetches this.
PORT=8810

# --- Weather (optional: weather / forecast / rain / sun) --------------------
# From Open-Meteo (free, no key) at this location. Blank = no weather panels.
# RAIN_LAT / RAIN_LON still work as old names for the same values.
DASH_LAT=                 # e.g. -23.55
DASH_LON=                 # e.g. -46.63
DASH_UNITS=metric         # metric (°C) or imperial (°F)
FORECAST_DAYS=3
RAIN_HOURS=12             # hours in the rain chart

# --- Agenda (optional) ------------------------------------------------------
# ICS calendars: comma list of iCal URLs (Google: settings -> Integrate
# calendar -> Secret address in iCal format). SECRET: anyone with the URL can
# read the calendar. They merge with the HA calendars below.
DASH_ICS_URLS=
# Home Assistant calendars. Long-lived token: HA -> Profile -> Security.
HA_BASE_URL=
HA_TOKEN=
HA_CALENDAR_ENTITY=       # e.g. calendar.personal,calendar.work  (comma list; blank = hide agenda)
DASH_MAX_EVENTS=4
DASH_EVENT_GRACE_MIN=15     # a timed event hides this many minutes after it starts

# --- Claude usage (optional: Session / Week / Sonnet bars) -----------------
# Seed from a DEDICATED Claude login, NOT a workstation's (see SECURITY.md):
#   mkdir -p ~/dash-claude-auth
#   env CLAUDE_CONFIG_DIR=$HOME/dash-claude-auth claude   # then /login, /exit
#   jq -r .claudeAiOauth.refreshToken ~/dash-claude-auth/.credentials.json
CLAUDE_REFRESH_TOKEN=
CLAUDE_POLL_MIN=15
# Defaults below are correct as of writing; override only if the (undocumented)
# endpoints move. See SECURITY.md.
# CLAUDE_TOKEN_URL=https://api.anthropic.com/v1/oauth/token
# CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage

# --- Codex usage (optional: Session / Week bars) — add `codex` to DASH_WIDGETS
# ChatGPT-subscription quota. Seed from a DEDICATED Codex login, NOT a
# workstation's (token rotation would log it out — see SECURITY.md):
#   CODEX_HOME=$HOME/dash-codex-auth codex login   # then exit
#   jq -r .tokens.refresh_token $HOME/dash-codex-auth/auth.json
CODEX_REFRESH_TOKEN=
CODEX_POLL_MIN=15
# account_id is read from the id_token JWT; set only to override.
# CODEX_ACCOUNT_ID=
# Defaults are correct as of writing; override only if the endpoints move.
# CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
# CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage

# --- opencode Go usage (optional: 5h / Week / Month bars) — add `opencode` ---
# opencode has NO usage API, so this scrapes the Go dashboard HTML with your
# browser session cookie. The cookie EXPIRES (days) with no refresh — when it
# dies the widget shows "(stale)" until you re-seed OPENCODE_AUTH_COOKIE.
# Get both from a logged-in browser on opencode.ai:
#   workspace id  — the wrk_… in the dashboard URL /workspace/<id>/go
#   auth cookie   — DevTools → Application → Cookies → opencode.ai → `auth`
OPENCODE_WORKSPACE_ID=
OPENCODE_AUTH_COOKIE=
OPENCODE_POLL_MIN=15

# --- OpenRouter monthly spend (optional: Month USD) — add `openrouter` -------
# Sums usage_monthly (USD, current UTC month) over all keys in the default
# workspace. Needs a MANAGEMENT key (openrouter.ai/settings/management-keys)
# — it can create/delete keys, so treat it as sensitive (see SECURITY.md).
OPENROUTER_MANAGEMENT_KEY=
# Monthly budget in USD: the bar shows spend / budget. Blank = USD text only.
OPENROUTER_MONTH_BUDGET=
OPENROUTER_POLL_MIN=15
